<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- v.1.3.5: jalan pulang login Google di Android.
                 Google MENOLAK alur consent di WebView tertanam, jadi halaman izinnya
                 dibuka di BROWSER SISTEM (lihat _bukaOAuth di authSupabase.js). Tanpa
                 intent-filter ini, browser itu tak punya cara mengembalikan pengguna ke
                 app: Supabase memulangkan ke `https://localhost/` yang hanya berarti di
                 dalam WebView Capacitor, sehingga alurnya mentok di halaman galat.
                 Itulah sebabnya login Google jalan di web/PWA tapi mati di Android.

                 launchMode MainActivity = singleTask (di atas), jadi tautan ini masuk ke
                 instance yang SUDAH berjalan dan sampai ke JS sebagai `appUrlOpen` —
                 bukan membuka app kedua yang kehilangan code_verifier PKCE.

                 ⚠️ Skema ini WAJIB juga terdaftar di Supabase → Auth → URL Configuration
                 → Redirect URLs sebagai `app.ammu.id://auth-callback`. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.ammu.id" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- v.100: ikon & warna notifikasi FCM (status bar) — silhouette putih logo Ammu.
             Tanpa ini, notif latar belakang FCM tampil sbg kotak putih default. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ammu" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ammu_notif_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ammu_default" />

        <!-- v.75.0526 (recovered v.87.0526): Widget Jam Hijri home screen -->
        <receiver
            android:name=".widgets.JamHijriWidget"
            android:exported="true"
            android:label="@string/widget_jam_hijri_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.ammu.id.widgets.JAM_HIJRI_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_jam_hijri_info" />
        </receiver>
        <!-- v.94.0626: Widget Kalender Pendidikan home screen -->
        <receiver
            android:name=".widgets.KalenderWidget"
            android:exported="true"
            android:label="@string/widget_kalender_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kalender_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v.1.2.2 (audit 23 Jul 2026): SCHEDULE_EXACT_ALARM + USE_EXACT_ALARM DIHAPUS.
         USE_EXACT_ALARM adalah izin TERBATAS Google Play — hanya untuk aplikasi yang
         fungsi INTINYA jam alarm, timer, atau kalender. Ammu = manajemen pesantren,
         jelas tak memenuhi; izin ini dipakai widget Jam Hijri (update tiap menit),
         yang bukan alasan sah. Aman dilepas TANPA ubah kode Java: scheduleNextUpdate()
         di JamHijriWidget sudah membungkus setExact() dengan try/catch SecurityException
         lalu jatuh ke set() inexact, ditambah updatePeriodMillis 30 menit di
         widget_jam_hijri_info.xml sebagai jaring. Praktisnya tak terasa: alarm inexact
         baru molor saat perangkat Doze — dan saat itu layar mati, widgetnya tak dilihat.
         JANGAN tambah kembali. -->
    <!-- v.85.0526: storage permissions untuk PDF export (Capacitor Filesystem + Share) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- v.103b: READ_MEDIA_IMAGES/VIDEO DIHAPUS (kebijakan Google Play "Penggunaan izin foto & video
         tidak valid"). App hanya pilih gambar sesekali (logo/foto profil/dokumen) lewat <input type="file">
         WebView = file chooser/photo picker sistem, yg TIDAK butuh izin ini. Jangan tambah kembali. -->
    <!-- v.1.2.2 (audit 23 Jul 2026): CAMERA + uses-feature camera DIHAPUS — izin
         MENGANGGUR. Plugin @capacitor/camera tidak terpasang dan tak ada satu pun
         pemakaian kamera di vue-app/src (nol hasil utk Camera/getUserMedia/capture=).
         Foto profil & logo dipilih lewat <input type="file"> = photo picker sistem,
         yang tak butuh izin apa pun. Persis pola READ_MEDIA_IMAGES di v.103b.
         Izin menganggur tetap tampil di halaman Play Store sbg "meminta akses kamera"
         dan mengundang pertanyaan kebijakan. Tambahkan HANYA bila benar-benar memakai
         kamera in-app (mis. memasang @capacitor/camera). -->

    <!-- v.87.0526: notifikasi (Android 13+) — wajib utk request izin runtime LocalNotifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v.93.0626: eksplisitkan permission yg sebelumnya hanya ter-merge dari library plugin -->
    <!-- @capacitor/network — deteksi online/offline (LED indikator top bar) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- @capacitor/haptics — getar halus saat tap tombol (directive v-haptic) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- @capacitor/local-notifications — re-schedule notifikasi setelah HP reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
