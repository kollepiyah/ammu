<?xml version="1.0" encoding="utf-8"?>
<!-- v.1.5.5 (Kyai 25 Nov 2026): widget Jadwal Sholat ala NU Online — latar teal + motif berlian
     (widget_bg, sama dengan kartu Hijriah Beranda). Atas: desa · tanggal; tengah: waktu berikutnya
     + hitung mundur, lima waktu (berikutnya disorot putih); bawah: 2 agenda terdekat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/js_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/js_kosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Buka aplikasi Ammu untuk memuat jadwal sholat"
        android:textColor="#CCFBF1"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/js_isi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/js_tempat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/widget_pin"
                android:drawablePadding="3dp"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/js_tanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="—"
                android:textColor="#CCFBF1"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/js_berikut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <Chronometer
                android:id="@+id/js_mundur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFBF1"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <LinearLayout android:id="@+id/js_sel0" style="@style/SelSholat">
                <TextView android:id="@+id/js_nama0" style="@style/SelSholatNama" />
                <TextView android:id="@+id/js_jam0" style="@style/SelSholatJam" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js_sel1" style="@style/SelSholat">
                <TextView android:id="@+id/js_nama1" style="@style/SelSholatNama" />
                <TextView android:id="@+id/js_jam1" style="@style/SelSholatJam" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js_sel2" style="@style/SelSholat">
                <TextView android:id="@+id/js_nama2" style="@style/SelSholatNama" />
                <TextView android:id="@+id/js_jam2" style="@style/SelSholatJam" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js_sel3" style="@style/SelSholat">
                <TextView android:id="@+id/js_nama3" style="@style/SelSholatNama" />
                <TextView android:id="@+id/js_jam3" style="@style/SelSholatJam" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js_sel4" style="@style/SelSholat"
                android:layout_marginEnd="0dp">
                <TextView android:id="@+id/js_nama4" style="@style/SelSholatNama" />
                <TextView android:id="@+id/js_jam4" style="@style/SelSholatJam" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/js_agenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:paddingTop="6dp"
            android:background="@drawable/widget_garis_atas">
            <LinearLayout android:id="@+id/js_ag0" style="@style/BarisAgenda">
                <TextView android:id="@+id/js_ag0_tgl" style="@style/ChipAgenda" />
                <TextView android:id="@+id/js_ag0_judul" style="@style/JudulAgenda" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js_ag1" style="@style/BarisAgenda">
                <TextView android:id="@+id/js_ag1_tgl" style="@style/ChipAgenda" />
                <TextView android:id="@+id/js_ag1_judul" style="@style/JudulAgenda" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
