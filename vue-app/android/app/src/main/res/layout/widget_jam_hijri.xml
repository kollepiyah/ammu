<?xml version="1.0" encoding="utf-8"?>
<!-- v.1.4.8 (Kyai 4 Nov 2026): SATU BARIS untuk ukuran 4x1.
     Kiri : tanggal Hijri (Arab) di atas, chip hari + tanggal Masehi di bawahnya.
     Kanan: jam besar dengan "WIB" sejajar garis dasarnya.
     Tinggi isi ±44dp — muat di satu baris petak launcher. Akar match_parent supaya latar
     gradient mengisi seluruh petak, isi ditaruh di tengah vertikal.
     Warna & latar tetap = kartu Hijri beranda (DashboardJamHijri.vue). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/widget_bg">

    <!-- Kiri: Hijri + (hari · Masehi) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_tanggal_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#CCFBF1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textDirection="rtl"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_hari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HARI"
                android:textColor="#CCFBF1"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_chip" />

            <TextView
                android:id="@+id/widget_tanggal_masehi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="—"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:textStyle="italic"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kanan: jam + WIB (sejajar garis dasar) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_jam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="WIB"
            android:textColor="#5EEAD4"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />
    </LinearLayout>
</LinearLayout>
