<?xml version="1.0" encoding="utf-8"?>
<!-- v.1.5.0 gelombang 3 — widget home screen "Tugas Saya" (Kyai 16 Nov 2026).
     Tiga slot TETAP (bukan ListView): RemoteViews dengan slot tetap jauh lebih ringan
     dan tak butuh RemoteViewsService, persis pola widget_kalender yang sudah terbukti. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tugas_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="TUGAS SAYA"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <TextView
            android:id="@+id/tugas_tanggal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tugas_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tak ada tugas terjadwal"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <!-- Slot 1 -->
    <LinearLayout
        android:id="@+id/tugas_slot1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_event_bg"
        android:visibility="gone">
        <TextView android:id="@+id/tugas_dot1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="10sp" android:textColor="#10B981"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tugas_judul1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#1E293B" android:textSize="12sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tugas_detail1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#64748B" android:textSize="10sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/tugas_jam1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#475569" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Slot 2 -->
    <LinearLayout
        android:id="@+id/tugas_slot2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_event_bg"
        android:visibility="gone">
        <TextView android:id="@+id/tugas_dot2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="10sp" android:textColor="#10B981"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tugas_judul2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#1E293B" android:textSize="12sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tugas_detail2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#64748B" android:textSize="10sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/tugas_jam2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#475569" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Slot 3 -->
    <LinearLayout
        android:id="@+id/tugas_slot3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/widget_event_bg"
        android:visibility="gone">
        <TextView android:id="@+id/tugas_dot3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="10sp" android:textColor="#10B981"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tugas_judul3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#1E293B" android:textSize="12sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tugas_detail3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#64748B" android:textSize="10sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/tugas_jam3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#475569" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
