<?xml version="1.0" encoding="utf-8"?>
<!-- v.1.5.5: widget Jadwal Sholat (4x2, menggantikan widget Kalender). Data didorong aplikasi lewat
     WidgetBridge; widget juga bangun sendiri di setiap waktu sholat & tengah malam. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_jadwal_sholat"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_jadwal_sholat_description" />
